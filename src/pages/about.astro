---
import Icon from '../components/Icon.astro';
import { SOCIAL_LINKS } from '../config';
import { PROFILE } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description={PROFILE.about[0]}>
	<header class="page-head">
		<p class="eyebrow">04 — About</p>
		<h1 class="page-title">About me</h1>
		<p class="page-lede">{PROFILE.role}</p>
	</header>

	<div class="about">
		<div class="prose bio">
			{PROFILE.about.map((p) => <p>{p}</p>)}
		</div>

		<aside class="side">
			<h2 class="eyebrow">Interests</h2>
			<ul class="interests">
				{
					PROFILE.hobbies.map((h) => (
						<li>
							<Icon name={h.icon} size={16} />
							{h.title}
						</li>
					))
				}
			</ul>

			{
				SOCIAL_LINKS.length > 0 && (
					<>
						<h2 class="eyebrow elsewhere">Elsewhere</h2>
						<ul class="links">
							{SOCIAL_LINKS.map((link) => (
								<li>
									<a href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined}>
										<Icon name={link.icon} size={16} />
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</>
				)
			}
		</aside>
	</div>
</BaseLayout>

<style>
	.about {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 11rem;
		gap: 2.5rem;
	}
	/* Drop cap on the first paragraph. */
	.bio p:first-child::first-letter {
		float: left;
		margin: 0.3rem 0.6rem 0 0;
		font-size: 3.6rem;
		line-height: 0.85;
		font-weight: 600;
		color: var(--accent);
	}
	.side {
		padding-left: 1.5rem;
		border-left: 1px solid var(--border);
	}
	.side .eyebrow {
		font-weight: 400;
	}
	.elsewhere {
		margin-top: 2rem;
	}
	.interests,
	.links {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.interests li,
	.links a {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.4rem 0;
		color: var(--fg-soft);
		font-size: 0.95rem;
	}
	.interests :global(svg),
	.links :global(svg) {
		color: var(--accent);
	}
	.links a {
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
	}
	@media (max-width: 760px) {
		.about {
			grid-template-columns: 1fr;
		}
		.side {
			padding: 1.5rem 0 0;
			border-left: 0;
			border-top: 1px solid var(--border);
		}
		.interests {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
